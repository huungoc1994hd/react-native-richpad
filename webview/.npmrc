# The WebView build bundles only the web output of @10play/tentap-editor
# (@10play/tentap-editor/web). tentap declares a peer dependency on react-native,
# which is irrelevant here and, if npm tries to satisfy it, pulls a react-native
# version whose react peer conflicts with the react 18 this bundle pins. This is a
# dev-only build that produces a self-contained HTML string, so we skip strict
# peer resolution (matching the yarn-classic behaviour this build was authored under).
legacy-peer-deps=true
