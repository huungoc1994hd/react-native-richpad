{
  "name": "richpad-webview",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only build for the react-native-richpad WebView editor. Regenerates src/webview/generated/editorHtml.ts; not shipped with the package.",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node build.js",
    "smoke-test": "node smoke-test.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-code-block-lowlight": "3.28.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-align": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "vite": "^5.4.14"
  }
}
